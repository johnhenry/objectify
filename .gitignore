/target
/objectify
.DS_Store
__pycache__/
*.pyc
.objectify/objectify.db
.objectify/deno.lock

# Per-platform binaries are build artifacts dropped in by the release
# workflow just before `npm publish` — never committed to the repo.
/npm/darwin-arm64/bin/*
/npm/darwin-x64/bin/*
/npm/linux-arm64/bin/*
/npm/linux-x64/bin/*
/npm/win32-x64/bin/*

# Checksum manifest for the platform binaries, generated by the release
# workflow and dropped into npm/objectify/ just before `npm publish`.
/npm/objectify/checksums.json

# JS/TS build output and dependency trees (npm workspaces root).
node_modules/
dist/
.turbo/
